{
  // 构建产物与 VS 中间目录不参与搜索/文件树污染
  "search.exclude": {
    "x64/": true,
    "**/x64/": true,
    "**/Debug/": true,
    "**/Release/": true,
    "**/.vs/": true
  },
  // IntelliSense 交给 clangd（读 .clangd 配置）；cpptools 仅保留调试器（cppvsdbg）和构建任务功能
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  // 仓库中部分文件为 UTF-16 LE（如 libcppcryptfs/stdafx.h），VS Code 凭 BOM 自动识别
  "files.autoGuessEncoding": true
}
